{
  "name": "audio-waves-visualizer",
  "private": true,
  "version": "0.1.0",
  "description": "Audio Waves Visualizer — 音楽と画像からド派手なビジュアライザー動画を作る Web アプリ",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build crates/awv-core --target web --release --out-dir ../../src/wasm/pkg --out-name awv_core",
    "dev": "npm run build:wasm && vite",
    "build": "npm run build:wasm && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path crates/awv-core/Cargo.toml"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
